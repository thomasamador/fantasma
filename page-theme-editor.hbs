{{!< default}}

<main class="gh-main">
<article class="gh-article">
<div class="gh-article-header gh-canvas">
    <h1 class="gh-article-title is-title">Theme Editor</h1>
</div>

<div class="gh-canvas">
    <p id="theme-editor-status" style="margin-bottom:24px;font-size:0.875rem;color:var(--color-secondary-text)"></p>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:24px;margin-bottom:32px">

        <label style="display:flex;flex-direction:column;gap:8px;font-size:0.875rem">
            Background
            <input type="color" data-token="--color-base-100" style="height:40px;width:100%;border:1px solid var(--color-border);border-radius:6px;cursor:pointer">
        </label>

        <label style="display:flex;flex-direction:column;gap:8px;font-size:0.875rem">
            Surface
            <input type="color" data-token="--color-base-200" style="height:40px;width:100%;border:1px solid var(--color-border);border-radius:6px;cursor:pointer">
        </label>

        <label style="display:flex;flex-direction:column;gap:8px;font-size:0.875rem">
            Border
            <input type="color" data-token="--color-base-300" style="height:40px;width:100%;border:1px solid var(--color-border);border-radius:6px;cursor:pointer">
        </label>

        <label style="display:flex;flex-direction:column;gap:8px;font-size:0.875rem">
            Text
            <input type="color" data-token="--color-base-content" style="height:40px;width:100%;border:1px solid var(--color-border);border-radius:6px;cursor:pointer">
        </label>

        <label style="display:flex;flex-direction:column;gap:8px;font-size:0.875rem">
            Primary
            <input type="color" data-token="--color-primary" style="height:40px;width:100%;border:1px solid var(--color-border);border-radius:6px;cursor:pointer">
        </label>

        <label style="display:flex;flex-direction:column;gap:8px;font-size:0.875rem">
            Secondary
            <input type="color" data-token="--color-secondary" style="height:40px;width:100%;border:1px solid var(--color-border);border-radius:6px;cursor:pointer">
        </label>

        <label style="display:flex;flex-direction:column;gap:8px;font-size:0.875rem">
            Accent
            <input type="color" data-token="--color-accent" style="height:40px;width:100%;border:1px solid var(--color-border);border-radius:6px;cursor:pointer">
        </label>

        <label style="display:flex;flex-direction:column;gap:8px;font-size:0.875rem">
            Neutral
            <input type="color" data-token="--color-neutral" style="height:40px;width:100%;border:1px solid var(--color-border);border-radius:6px;cursor:pointer">
        </label>

    </div>

    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:32px">
        <button id="theme-editor-reset" class="gh-button" style="background:var(--color-lighter-gray);color:var(--color-primary-text)">Reset</button>
        <button id="theme-editor-export" class="gh-button">Export theme</button>
    </div>

    <pre id="theme-editor-output" style="display:none;padding:20px;background:var(--color-lighter-gray);border-radius:8px;font-size:0.8125rem;overflow-x:auto;white-space:pre-wrap"></pre>
</div>
</article>
</main>

<script>
(function () {
    var STORAGE_KEY = 'fantasma-theme';
    var status = document.getElementById('theme-editor-status');
    var output = document.getElementById('theme-editor-output');
    var inputs = document.querySelectorAll('[data-token]');

    // Auth check — informational only, does not block the UI
    fetch('/ghost/api/admin/users/me/', {
        credentials: 'include',
        headers: { 'Accept': 'application/json', 'Accept-Version': 'v5.0' }
    })
        .then(function (res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
        })
        .then(function (data) {
            var name = data.users && data.users[0] && data.users[0].name;
            status.textContent = name ? 'Editing as ' + name : '';
        })
        .catch(function (err) {
            status.textContent = 'Admin session not detected (' + err.message + '). Changes still apply locally.';
        });

    // Convert a CSS color string (oklch, rgb, etc.) to #rrggbb via canvas
    function colorToHex(str) {
        if (!str) return '#000000';
        var canvas = document.createElement('canvas');
        canvas.width = canvas.height = 1;
        var ctx = canvas.getContext('2d');
        ctx.fillStyle = '#000000'; // reset
        ctx.fillStyle = str;
        ctx.fillRect(0, 0, 1, 1);
        var d = ctx.getImageData(0, 0, 1, 1).data;
        return '#' + [d[0], d[1], d[2]].map(function (v) {
            return v.toString(16).padStart(2, '0');
        }).join('');
    }

    function tokenToHex(token) {
        var raw = getComputedStyle(document.documentElement).getPropertyValue(token).trim();
        return colorToHex(raw);
    }

    function hexToOklch(hex) {
        var r = parseInt(hex.slice(1, 3), 16) / 255;
        var g = parseInt(hex.slice(3, 5), 16) / 255;
        var b = parseInt(hex.slice(5, 7), 16) / 255;

        r = r <= 0.04045 ? r / 12.92 : Math.pow((r + 0.055) / 1.055, 2.4);
        g = g <= 0.04045 ? g / 12.92 : Math.pow((g + 0.055) / 1.055, 2.4);
        b = b <= 0.04045 ? b / 12.92 : Math.pow((b + 0.055) / 1.055, 2.4);

        var X = r * 0.4124564 + g * 0.3575761 + b * 0.1804375;
        var Y = r * 0.2126729 + g * 0.7151522 + b * 0.0721750;
        var Z = r * 0.0193339 + g * 0.1191920 + b * 0.9503041;

        var l = Math.cbrt(0.8189330101 * X + 0.3618667424 * Y - 0.1288597137 * Z);
        var m = Math.cbrt(0.0329845436 * X + 0.9293118715 * Y + 0.0361456387 * Z);
        var s = Math.cbrt(0.0482003018 * X + 0.2643662691 * Y + 0.6338517070 * Z);

        var L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s;
        var A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s;
        var B = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s;

        var C = Math.sqrt(A * A + B * B);
        var H = Math.atan2(B, A) * (180 / Math.PI);
        if (H < 0) H += 360;

        return 'oklch(' + (Math.round(L * 1000) / 10) + '% ' + (Math.round(C * 1000) / 1000) + ' ' + (Math.round(H * 10) / 10) + ')';
    }

    function applyCustomTokens(tokens) {
        var existing = document.getElementById('fantasma-custom-theme');
        if (!existing) {
            existing = document.createElement('style');
            existing.id = 'fantasma-custom-theme';
            document.head.appendChild(existing);
        }

        var lines = Object.keys(tokens).map(function (t) {
            return '    ' + t + ': ' + hexToOklch(tokens[t]) + ';';
        });
        existing.textContent = '[data-theme="custom"] {\n' + lines.join('\n') + '\n}';

        var tokenStr = Object.keys(tokens).map(function (t) {
            return t + ': ' + hexToOklch(tokens[t]) + ';';
        }).join(' ');

        document.documentElement.setAttribute('data-theme', 'custom');
        localStorage.setItem(STORAGE_KEY, 'custom');
        localStorage.setItem('fantasma-custom-tokens', tokenStr);
    }

    // Initialise pickers with current token values
    inputs.forEach(function (inp) {
        inp.value = tokenToHex(inp.dataset.token);
        inp.addEventListener('input', function () {
            var tokens = {};
            inputs.forEach(function (i) { tokens[i.dataset.token] = i.value; });
            applyCustomTokens(tokens);
        });
    });

    document.getElementById('theme-editor-reset').addEventListener('click', function () {
        localStorage.removeItem('fantasma-custom-tokens');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = prefersDark ? 'dracula' : 'light';
        localStorage.setItem(STORAGE_KEY, theme);
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.className = (theme === 'light') ? 'has-dark-text' : 'has-light-text';
        var style = document.getElementById('fantasma-custom-theme');
        if (style) style.remove();
        inputs.forEach(function (inp) { inp.value = tokenToHex(inp.dataset.token); });
        output.style.display = 'none';
    });

    document.getElementById('theme-editor-export').addEventListener('click', function () {
        var lines = ['@plugin "daisyui/theme" {', '    name: "custom";', '    color-scheme: "light";'];
        inputs.forEach(function (inp) {
            lines.push('    ' + inp.dataset.token + ': ' + hexToOklch(inp.value) + ';');
        });
        lines.push('}');
        output.textContent = lines.join('\n');
        output.style.display = 'block';
    });
})();
</script>
