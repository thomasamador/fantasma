<div class="gh-feed-filters">
    <div class="gh-feed-filter-types" role="group" aria-label="Filter by post type">
        <button class="gh-filter-btn is-active" data-filter="all">All</button>
        <button class="gh-filter-btn" data-filter="note">Notes</button>
        <button class="gh-filter-btn" data-filter="sketch">Sketches</button>
        <button class="gh-filter-btn" data-filter="essay">Essays</button>
        <button class="gh-filter-btn" data-filter="story">Stories</button>
        <button class="gh-filter-btn" data-filter="update">Updates</button>
    </div>
    <div class="gh-feed-sort">
        <button class="gh-sort-btn" data-sort="latest" aria-pressed="true">Latest</button>
        <button class="gh-sort-btn" data-sort="oldest" aria-pressed="false">Oldest</button>
    </div>
</div>
